"""
Warehouse Delivery Robot - BFS and DFS on a 5x5 grid
Cells are (row, col), 1-indexed. Start=(1,1), Goal=(5,5)
Move order (tie-breaking): Up, Down, Left, Right
"""

from collections import deque

N = 5
START, GOAL = (1, 1), (5, 5)
BLOCKED = {(2, 2), (2, 3), (3, 3), (4, 2), (4, 4)}
MOVES = [("Up", -1, 0), ("Down", 1, 0), ("Left", 0, -1), ("Right", 0, 1)]

def actions(state):
    """Return list of (action, next_state) that are legal from state."""
    r, c = state
    result = []
    for name, dr, dc in MOVES:
        nr, nc = r + dr, c + dc
        if 1 <= nr <= N and 1 <= nc <= N and (nr, nc) not in BLOCKED:
            result.append((name, (nr, nc)))
    return result

def build_path(parent, state):
    path = []
    while state is not None:
        path.append(state)
        state = parent[state]
    return path[::-1]

def fmt(cells):
    return "[" + ", ".join(f"({r},{c})" for r, c in cells) + "]"

def print_grid(path=None):
    path = set(path or [])
    print("   c1 c2 c3 c4 c5")
    for r in range(1, N + 1):
        row = f"r{r} "
        for c in range(1, N + 1):
            if (r, c) == START:    ch = " S "
            elif (r, c) == GOAL:   ch = " G "
            elif (r, c) in BLOCKED: ch = " # "
            elif (r, c) in path:   ch = " * "
            else:                  ch = " . "
            row += ch + " "
        print(row.rstrip())

def bfs():
    frontier = deque([START])
    parent = {START: None}
    explored = []
    step = 0
    print("=== BFS (Queue: FIFO) ===")
    print(f"Initial queue: {fmt(frontier)}")
    while frontier:
        node = frontier.popleft() # dequeue from front
        step += 1
        explored.append(node)
        if node == GOAL:
            print(f"Step {step:2d}: Dequeue {node} -> GOAL REACHED")
            break
        added = []
        for name, nxt in actions(node):
            if nxt not in parent: # not visited / not in frontier
                parent[nxt] = node
                frontier.append(nxt) # enqueue at back
                added.append(nxt)
        node_str = f"({node[0]}, {node[1]})"
        print(f"Step {step:2d}: Dequeue {node_str:<8s} add {fmt(added):28s} Queue: {fmt(frontier)}")
    path = build_path(parent, GOAL)
    print(f"\nNodes expanded (order): {fmt(explored)}")
    print(f"Path : {' -> '.join(map(str, path))}")
    print(f"Cost : {len(path) - 1}")
    return path, explored

def dfs():
    stack = [(START, None)] # stack holds (state, parent)
    parent = {}
    visited = set()
    explored = []
    step = 0
    show = lambda stk: fmt([n for n, _ in stk])
    print("=== DFS (Stack: LIFO) ===")
    print(f"Initial stack (top at right): {show(stack)}")
    while stack:
        node, par = stack.pop() # pop from top
        if node in visited:
            continue
        visited.add(node)
        parent[node] = par
        step += 1
        explored.append(node)
        if node == GOAL:
            print(f"Step {step:2d}: Pop {node} -> GOAL REACHED")
            break
        pushed = []
        # push in reverse so that 'Up' ends on top of the stack
        for name, nxt in reversed(actions(node)):
            if nxt not in visited:
                stack.append((nxt, node))
                pushed.append(nxt)
        node_str = f"({node[0]}, {node[1]})"
        print(f"Step {step:2d}: Pop {node_str:<8s} push {fmt(pushed):28s} Stack: {show(stack)}")
    path = build_path(parent, GOAL)
    print(f"\nNodes expanded (order): {fmt(explored)}")
    print(f"Path : {' -> '.join(map(str, path))}")
    print(f"Cost : {len(path) - 1}")
    return path, explored

if __name__ == "__main__":
    print("Warehouse layout (S=start, G=goal, #=shelf)")
    print_grid()
    print()
    bpath, bexp = bfs()
    print()
    print_grid(bpath)
    print("\n")
    dpath, dexp = dfs()
    print()
    print_grid(dpath)

